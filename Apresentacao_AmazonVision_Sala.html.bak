()=>{
  head(17,'Onde estamos');
  [['Painel e API',1,C.green,'pronto ✓'],['IA e treinamento',1,C.green,'pronto ✓'],['Firmware (lógica)',1,C.green,'pronto ✓'],['Modelo da castanha',1,C.green,'treinado ✓'],['Montagem da bancada',.35,C.amber,'em andamento'],['Fotos reais + critérios A/B/C',.12,C.amber,'próximo'],['Copiloto com IA generativa',0,C.dim,'futuro']].forEach(([l,f,c,s],i)=>{
    const y=215+i*88;auto();lock++;
    T(80,y+10,l,{size:30,color:f?C.ink:C.dim});
    box(640,y-22,700,44,{color:c,r:22,dash:!f,tint:false});
    if(f)put(rc.path(rr(X(645),Y(y-17),690*f,34,17),SO({stroke:'none',fill:rgba(c,.75),hachureGap:7})),'draw');
    T(1370,y+10,s,{size:26,color:c});
    lock--;
  });
},
// 18 · fim
()=>{
  T(800,330,'Obrigado!',{size:136,anchor:'middle'});
  T(800,440,'Perguntas?',{size:64,anchor:'middle',color:C.green});
  seq(250,600,['ENXERGAR','APRENDER','DECIDIR','AGIR'],{size:28,colors:[C.blue,C.purple,C.amber,C.green],hatch:true});
  stick(1430,640,{wave:true});
  T(800,830,'AmazonVision 4.0 · IA aplicada à bioeconomia amazônica',{size:30,anchor:'middle',color:C.dim});
},
];

function build(){
  // primeiro passo em que cada região aparece
  const first={};STEPS.forEach((s,i)=>{if(first[s.r]==null)first[s.r]=i+1});
  // conectores entre as seções (aparecem quando a seção seguinte chega)
  for(let i=0;i<NREG-1;i++){
    REG=-1;OX=0;OY=0;STEP=first[i+1];BEAT=0;
    const a=[RX(i),RY(i)],b=[RX(i+1),RY(i+1)];let P;
    if(a[1]===b[1])P=a[0]<b[0]?[[a[0]+RW+40,a[1]+RH/2],[b[0]-40,b[1]+RH/2]]:[[a[0]-40,a[1]+RH/2],[b[0]+RW+40,b[1]+RH/2]];
    else P=[[a[0]+RW/2,a[1]+RH+40],[b[0]+RW/2,b[1]-40]];
    arrow(P,{color:'#3a463d',dash:true,sw:2.5});
  }
  REGIONS.forEach((fn,i)=>{REG=i;OX=RX(i);OY=RY(i);at(first[i]);fn()});
  for(const rec of ELS)rec.g.style.display='none';
}

/* ---------- câmera ---------- */
let vb={x:0,y:0,w:RW,h:RH},camRAF=0,panelOpen=true,clean=false;
const bodyStyle=document.body.style;
function setVB(v){
  vb=v;svg.setAttribute('viewBox',`${v.x} ${v.y} ${v.w} ${v.h}`);
  cull(v);setGrid(v);
}
// só as seções à vista são desenhadas
function cull(v){
  for(let r=0;r<NREG;r++){
    const g=RG[r];if(!g)continue;
    const vis=RX(r)-120<v.x+v.w&&RX(r)+RW+120>v.x&&RY(r)-120<v.y+v.h&&RY(r)+RH+120>v.y;
    const d=vis?'':'none';if(g.style.display!==d)g.style.display=d;
  }
}
// fundo pontilhado em CSS, acompanhando a câmera
function setGrid(v){
  const s=innerWidth/v.w,gs=36*s;
  if(gs<12){if(bodyStyle.backgroundImage!=='none')bodyStyle.backgroundImage='none'}
  else{if(bodyStyle.backgroundImage==='none')bodyStyle.backgroundImage='';bodyStyle.backgroundSize=`${gs}px ${gs}px`;bodyStyle.backgroundPosition=`${-v.x*s}px ${-v.y*s}px`}
}
function fit(r,note){
  const W=Math.max(innerWidth,320),H=Math.max(innerHeight,180),ui=!clean;
  const L=ui?92:30,R=ui&&panelOpen?300:30,Tp=ui?60:30,B=note?(ui?200:150):ui?80:30;
  const aw=Math.max(200,W-L-R),ah=Math.max(200,H-Tp-B),s=Math.min(aw/r.w,ah/r.h);
  return {x:r.x-(L+(aw-r.w*s)/2)/s,y:r.y-(Tp+(ah-r.h*s)/2)/s,w:W/s,h:H/s};
}
const ease=k=>k<.5?4*k*k*k:1-Math.pow(-2*k+2,3)/2;
// ?static: sem animações (útil em computador fraco e para gerar imagens)
const STATIC=new URLSearchParams(location.search).has('static');
/* Viagem da câmera: o trecho do quadro que a câmera vai percorrer é desenhado
   uma vez só, como uma camada; durante a viagem a placa de vídeo apenas move e
   amplia essa camada. Na chegada, volta ao desenho normal (nítido). */
let flying=false;
function startFlight(U,sR){
  flying=true;svg.classList.add('flying');
  svg.style.width=U.w*sR+'px';svg.style.height=U.h*sR+'px';
  svg.setAttribute('viewBox',`${U.x} ${U.y} ${U.w} ${U.h}`);cull(U);
}
function endFlight(){
  if(!flying)return;flying=false;
  svg.classList.remove('flying');svg.style.width=svg.style.height=svg.style.transform='';setVB(vb);
}
function stopCam(){cancelAnimationFrame(camRAF);endFlight()}
// devolve a duração da viagem, para as entradas começarem na chegada
function flyTo(t,dur){
  stopCam();if(STATIC){setVB(t);return 0}
  const f={...vb},fc=[f.x+f.w/2,f.y+f.h/2],tc=[t.x+t.w/2,t.y+t.h/2];
  const hops=Math.hypot(tc[0]-fc[0],tc[1]-fc[1])/Math.max(f.w,t.w);
  dur=dur||Math.round(650+Math.min(550,hops*250));
  const bump=Math.min(.6,hops*.24),lf=Math.log(f.w),lt=Math.log(t.w);
  const frame=e=>{const w=Math.exp(lf+(lt-lf)*e)*(1+bump*Math.sin(Math.PI*e)),h=w*(t.h/t.w);return {x:fc[0]+(tc[0]-fc[0])*e-w/2,y:fc[1]+(tc[1]-fc[1])*e-h/2,w,h}};
  let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;
  for(let i=0;i<=32;i++){const r=frame(ease(i/32));x0=Math.min(x0,r.x);y0=Math.min(y0,r.y);x1=Math.max(x1,r.x+r.w);y1=Math.max(y1,r.y+r.h)}
  const U={x:x0,y:y0,w:x1-x0,h:y1-y0},W=innerWidth;
  // resolução da camada: a das pontas (nítido na saída e na chegada), com limite de memória
  const sR=Math.min(Math.max(W/f.w,W/t.w),7000/devicePixelRatio/U.w,7000/devicePixelRatio/U.h);
  startFlight(U,sR);
  let t0=0;
  const tick=now=>{
    if(!t0)t0=now;
    const k=Math.min(1,(now-t0)/dur),r=frame(ease(k)),s=W/r.w;
    vb=r;svg.style.transform=`translate(${(U.x-r.x)*s}px,${(U.y-r.y)*s}px) scale(${s/sR})`;setGrid(r);
    if(k<1)camRAF=requestAnimationFrame(tick);else{vb=t;endFlight()}
  };camRAF=requestAnimationFrame(tick);
  return dur;
}
const camFor=()=>overview?fit(overviewRect()):fit(STEPS[cur].cam||regionRect(STEPS[cur].r),!!STEPS[cur].note);
const regionRect=r=>({x:RX(r)-30,y:RY(r)-20,w:RW+60,h:RH+40});
function overviewRect(){const rows=Math.ceil(NREG/COLS);return {x:-80,y:-80,w:(COLS-1)*CW+RW+160,h:(rows-1)*CH+RH+160}}

/* ---------- navegação ---------- */
let cur=0,overview=false,dimOn=true,calloutTimer=0;
const EASE_DRAW='cubic-bezier(.45,.05,.25,1)',EASE_OUT='cubic-bezier(.2,.8,.2,1)',EASE_POP='cubic-bezier(.34,1.45,.64,1)';
function reveal(rec,delay){
  rec.shown=true;const g=rec.g;g.style.display='';
  if(rec.kind==='draw'){
    // contorno primeiro, hachura depois
    rec.paths.forEach(([p,L],i)=>{
      const dur=Math.min(650,Math.max(280,L*.55));
      p.style.strokeDasharray=L;
      const a=p.animate([{strokeDashoffset:L},{strokeDashoffset:0}],{duration:dur,delay:delay+i*90,easing:EASE_DRAW,fill:'both'});
      a.onfinish=()=>{p.style.strokeDasharray='';a.cancel()};
    });
  }else if(rec.kind==='text'){
    g.animate([{opacity:0,transform:'translateY(16px)'},{opacity:1,transform:'none'}],{duration:520,delay,easing:EASE_OUT,fill:'backwards'});
  }else{
    g.animate([{opacity:0,transform:'scale(.94)'},{opacity:1,transform:'none'}],{duration:560,delay,easing:EASE_POP,fill:'backwards'});
  }
}
function apply(animate,delay0,soft){
  const step=cur+1,reg=STEPS[cur].r;
  for(const a of document.getAnimations()){const t=a.effect&&a.effect.target;if(t&&world.contains(t))a.finish()}
  // intervalo entre entradas: a seção inteira aparece em ~1,4 s, cheia ou vazia
  let maxBeat=1;for(const rec of ELS)if(rec.step===step&&rec.beat>maxBeat)maxBeat=rec.beat;
  const gap=Math.min(120,1400/maxBeat);
  for(const r in RG){const v=+r;RG[r].style.opacity=v<0?(overview?.6:.35):(overview||!dimOn||v===reg)?1:.15}
  for(const rec of ELS){
    const g=rec.g;
    if(rec.step<=step){
      if(g.style.opacity)g.style.opacity='';
      // bolinhas animadas só na seção atual (fora dela gastariam desenho à toa)
      if(rec.flow&&(overview||rec.region!==reg)){g.style.display='none';continue}
      if(!rec.shown&&animate&&!STATIC&&rec.step===step)reveal(rec,delay0+rec.beat*gap);
      else{rec.shown=true;g.style.display=''}
    }else if(overview){rec.shown=false;g.style.display='';g.style.opacity=.07}
    else if(rec.shown&&soft&&rec.step===step+1&&!STATIC){
      // voltando um passo: o que sai some suavemente
      rec.shown=false;
      g.animate([{opacity:1,transform:'none'},{opacity:0,transform:'translateY(8px)'}],{duration:260,easing:'ease-in'}).onfinish=()=>{if(!rec.shown)g.style.display='none'};
    }else{rec.shown=false;g.style.display='none'}
  }
}
function go(i,opts={}){
  i=Math.max(0,Math.min(STEPS.length-1,i));
  const prev=cur,moved=STEPS[i].r!==STEPS[prev].r||overview||opts.first;
  const forward=i===prev+1||opts.first;
  cur=i;overview=false;inkLayer.replaceChildren();
  const dur=flyTo(camFor(),opts.first?1500:0);
  const d0=moved?dur+40:40;
  apply(forward,d0,!moved);
  ui(d0+450);
  history.replaceState(null,'','#'+(i+1));
}
function toggleOverview(){
  overview=!overview;
  if(overview){flyTo(fit(overviewRect()),1000);apply(false,0)}else go(cur);
  ui(0);
}
function ui(calloutDelay){
  document.querySelectorAll('#list li').forEach((li,i)=>{li.className=i===cur?'cur':i<cur?'done':''});
  document.querySelectorAll('#dots i').forEach((d,i)=>{d.className=i===cur?'cur':i<cur?'done':''});
  document.getElementById('ov').classList.toggle('on',overview);
  document.getElementById('dimBtn').classList.toggle('on',dimOn);
  const li=document.querySelector('#list li.cur');if(li)li.scrollIntoView({block:'nearest'});
  const co=document.getElementById('callout'),n=STEPS[cur].note;
  co.classList.remove('on');clearTimeout(calloutTimer);
  if(n&&!overview)calloutTimer=setTimeout(()=>{co.querySelector('.lab').textContent=n[0];co.querySelector('.tit').textContent=n[1];co.querySelector('.sub').textContent=n[2]||'';co.classList.add('on')},STATIC?0:calloutDelay||0);
}

/* ---------- interface ---------- */
const list=document.getElementById('list'),dots=document.getElementById('dots');
STEPS.forEach((s,i)=>{
  const li=document.createElement('li');li.innerHTML=`<span>${i+1}</span>`;li.append(s.t);li.onclick=()=>go(i);list.appendChild(li);
  const d=document.createElement('i');d.title=s.t;d.onclick=()=>go(i);dots.appendChild(d);
});
document.getElementById('prev').onclick=()=>go(cur-1);
document.getElementById('next').onclick=()=>go(cur+1);
document.getElementById('ov').onclick=toggleOverview;
document.getElementById('dimBtn').onclick=()=>{dimOn=!dimOn;apply(false,0);ui()};
const togglePanel=()=>{panelOpen=!panelOpen;document.body.classList.toggle('collapsed',!panelOpen);document.getElementById('collapse').textContent=(panelOpen?'▾':'▸')+' passos';flyTo(camFor(),600)};
document.getElementById('collapse').onclick=togglePanel;
document.getElementById('menu').onclick=togglePanel;
const help=document.getElementById('help');
document.getElementById('helpBtn').onclick=()=>help.classList.toggle('on');
const toggleClean=()=>{clean=!clean;document.body.classList.toggle('clean',clean);flyTo(camFor(),600)};
document.getElementById('tClean').onclick=toggleClean;
const toggleFull=()=>document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen();
document.getElementById('tFull').onclick=toggleFull;

// ferramentas: mover / caneta
let tool='move',penColor=C.green;
const PEN=[C.green,C.ink,C.amber,C.blue,C.red];
const sw=document.getElementById('swatches');
PEN.forEach((c,i)=>{const d=document.createElement('div');d.className='sw'+(i===0?' on':'');d.style.background=c;d.title='cor '+(i+1);d.onclick=()=>setColor(i);sw.appendChild(d)});
function setColor(i){penColor=PEN[i];[...sw.children].forEach((d,j)=>d.classList.toggle('on',i===j));setTool('pen')}
function setTool(t){tool=t;document.getElementById('tMove').classList.toggle('on',t==='move');document.getElementById('tPen').classList.toggle('on',t==='pen');svg.classList.toggle('pen',t==='pen')}
document.getElementById('tMove').onclick=()=>setTool('move');
document.getElementById('tPen').onclick=()=>setTool('pen');
document.getElementById('tClear').onclick=()=>inkLayer.replaceChildren();

const toWorld=(cx,cy)=>[vb.x+cx/innerWidth*vb.w,vb.y+cy/innerHeight*vb.h];
let drag=null;
svg.addEventListener('pointerdown',e=>{
  if(e.button!==0)return;svg.setPointerCapture(e.pointerId);
  if(tool==='pen'){const p=toWorld(e.clientX,e.clientY);const path=mk('path',{stroke:penColor,'stroke-width':4.5,'vector-effect':'non-scaling-stroke'},inkLayer);drag={pen:path,pts:[p]};path.setAttribute('d',`M${p[0]} ${p[1]} l0.01 0`)}
  else{stopCam();drag={x:e.clientX,y:e.clientY,vb:{...vb}};svg.classList.add('dragging')}
});
svg.addEventListener('pointermove',e=>{
  if(!drag)return;
  if(drag.pen){const p=toWorld(e.clientX,e.clientY),q=drag.pts[drag.pts.length-1];if(Math.hypot(p[0]-q[0],p[1]-q[1])<vb.w/900)return;drag.pts.push(p);
    const P=drag.pts;let d=`M${P[0][0]} ${P[0][1]}`;for(let i=1;i<P.length-1;i++){const mx=(P[i][0]+P[i+1][0])/2,my=(P[i][1]+P[i+1][1])/2;d+=` Q${P[i][0]} ${P[i][1]} ${mx} ${my}`}d+=` L${p[0]} ${p[1]}`;drag.pen.setAttribute('d',d)}
  else{const k=drag.vb.w/innerWidth;setVB({...drag.vb,x:drag.vb.x-(e.clientX-drag.x)*k,y:drag.vb.y-(e.clientY-drag.y)*k})}
});
const end=()=>{drag=null;svg.classList.remove('dragging')};
svg.addEventListener('pointerup',end);svg.addEventListener('pointercancel',end);
svg.addEventListener('wheel',e=>{
  e.preventDefault();stopCam();
  const f=Math.exp(e.deltaY*.0012),[px,py]=toWorld(e.clientX,e.clientY),w=Math.min(30000,Math.max(300,vb.w*f)),h=w*vb.h/vb.w;
  setVB({x:px-e.clientX/innerWidth*w,y:py-e.clientY/innerHeight*h,w,h});
},{passive:false});

addEventListener('keydown',e=>{
  if(e.ctrlKey||e.metaKey||e.altKey)return;
  const k=e.key;
  if(['ArrowRight','PageDown',' ','Enter','ArrowDown'].includes(k)){e.preventDefault();go(cur+1)}
  else if(['ArrowLeft','PageUp','Backspace','ArrowUp'].includes(k)){e.preventDefault();go(cur-1)}
  else if(k==='Home')go(0);else if(k==='End')go(STEPS.length-1);
  else if(k==='o'||k==='O')toggleOverview();
  else if(k==='d'||k==='D'){dimOn=!dimOn;apply(false,0);ui()}
  else if(k==='p'||k==='P')setTool('pen');
  else if(k==='v'||k==='V'||k==='Escape'){setTool('move');help.classList.remove('on')}
  else if(k==='c'||k==='C')inkLayer.replaceChildren();
  else if(k==='h'||k==='H')toggleClean();
  else if(k==='f'||k==='F')toggleFull();
  else if(k==='?')help.classList.toggle('on');
  else if(/^[1-5]$/.test(k))setColor(+k-1);
});
let rz=0;addEventListener('resize',()=>{clearTimeout(rz);rz=setTimeout(()=>{stopCam();setVB(camFor())},120)});

/* ---------- início ---------- */
(async()=>{
  if(STATIC)document.body.classList.add('static');
  try{await Promise.all(['400','500','700'].map(w=>document.fonts.load(w+' 40px Roboto')))}catch(_){}
  build();
  setVB(fit(overviewRect()));
  const h=parseInt(location.hash.slice(1),10);
  const start=h>=1&&h<=STEPS.length?h-1:0;
  cur=start;go(start,{first:true});
})();
</script>
</body>
</html>
