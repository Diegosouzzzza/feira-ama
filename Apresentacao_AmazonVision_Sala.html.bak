<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AmazonVision 4.0 · Apresentação</title>
<style>
@font-face{font-family:Roboto;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');font-display:block}
@font-face{font-family:Roboto;font-weight:500;src:url(data:font/woff2;base64,) format('woff2');font-display:block}
@font-face{font-family:Roboto;font-weight:700;src:url(data:font/woff2;base64,) format('woff2');font-display:block}
:root{--bg:#0a0e0b;--ink:#e7ece5;--dim:#8a958c;--line:#27302a;--green:#4ade80;--panel:rgba(12,17,14,.88)}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background-color:var(--bg);color:var(--ink);overflow:hidden;font-family:Roboto,'Segoe UI',system-ui,sans-serif;user-select:none}
#stage{position:fixed;inset:0;width:100vw;height:100vh;display:block;touch-action:none;cursor:grab}
#stage.pen{cursor:crosshair}
#stage.flying{will-change:transform;transform-origin:0 0}
#stage.flying .flow{display:none}
#stage.flying .rg{transition:none}
#stage.dragging{cursor:grabbing}
#stage text{font-family:Roboto,'Segoe UI',system-ui,sans-serif}
body{background-image:radial-gradient(circle,#1c251f 1.6px,transparent 2px)}
.rg{transition:opacity .5s ease}
.el{transform-box:fill-box;transform-origin:center}
body.static .rg,body.static #callout{transition:none}
button{font:inherit;color:var(--ink);background:transparent;border:1.5px solid var(--line);border-radius:10px;cursor:pointer}
button:hover{border-color:#3d4a40}
#menu{position:fixed;top:16px;left:16px;padding:7px 14px;font-size:19px;background:var(--panel);z-index:5}
#tools{position:fixed;left:16px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:8px;padding:10px 8px;background:var(--panel);border:1.5px solid var(--line);border-radius:14px;z-index:5}
#tools button{width:40px;height:40px;font-size:20px;border-color:transparent;display:grid;place-items:center}
#tools button.on{border-color:var(--green);color:var(--green);background:rgba(74,222,128,.08)}
#tools .sw{width:22px;height:22px;border-radius:50%;margin:2px auto;border:2px solid transparent;cursor:pointer}
#tools .sw.on{border-color:var(--ink)}
#tools hr{width:26px;border:0;border-top:1.5px solid var(--line);margin:4px auto}
#panel{position:fixed;right:16px;top:64px;width:268px;max-height:calc(100vh - 160px);overflow:auto;padding:12px 10px;background:var(--panel);border:1.5px solid var(--line);border-radius:14px;z-index:5}
#panel .ph{display:flex;align-items:center;justify-content:space-between;margin:0 4px 8px}
#collapse{border:0;font-size:20px;padding:2px 4px}
#dimBtn{font-size:15px;padding:3px 10px}
#dimBtn.on{background:var(--green);color:#06210f;border-color:var(--green)}
#list{list-style:none;margin:0;padding:0}
#list li{display:flex;gap:10px;align-items:baseline;padding:5px 8px;border-radius:8px;font-size:17px;color:#b9c3bb;cursor:pointer}
#list li span{width:22px;text-align:right;color:#5d685f;font-size:14px}
#list li:hover{background:rgba(255,255,255,.04)}
#list li.cur{background:rgba(74,222,128,.13);color:var(--green)}
#list li.done{color:#7f8a81}
body.collapsed #list{display:none}
#nav{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);display:flex;align-items:center;gap:12px;z-index:5}
#nav>button{padding:5px 14px;font-size:20px;background:var(--panel)}
#nav #ov{font-size:16px;padding:7px 14px}
#nav #ov.on{border-color:var(--green);color:var(--green)}
#dots{display:flex;gap:7px;padding:0 6px}
#dots i{display:block;width:9px;height:9px;border-radius:50%;border:1.5px solid #4b574e;cursor:pointer}
#dots i.done{background:#4b574e}
#dots i.cur{background:var(--green);border-color:var(--green);transform:scale(1.25)}
#callout{position:fixed;left:96px;bottom:92px;min-width:300px;max-width:440px;padding:14px 20px 16px;background:rgba(14,19,16,.97);border:1.5px solid #2c352f;border-radius:14px;z-index:4;opacity:0;transform:translateY(14px);transition:opacity .5s cubic-bezier(.2,.8,.2,1),transform .5s cubic-bezier(.2,.8,.2,1);pointer-events:none}
#callout.on{opacity:1;transform:none}
#callout .lab{font:500 12px/1.2 Roboto,'Segoe UI',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
#callout .tit{font-size:24px;font-weight:500;margin-top:6px;color:var(--ink)}
#callout .sub{font:15px/1.4 Roboto,'Segoe UI',sans-serif;color:var(--dim);margin-top:4px}
#helpBtn{position:fixed;left:16px;bottom:18px;width:38px;height:38px;border-radius:50%;font-size:18px;background:var(--panel);z-index:5}
#help{position:fixed;left:64px;bottom:18px;padding:14px 18px;background:rgba(14,19,16,.95);border:1.5px solid var(--line);border-radius:14px;font:14px/1.75 Roboto,'Segoe UI',sans-serif;color:#c9d2cb;z-index:6;display:none}
#help.on{display:block}
#help b{display:inline-block;min-width:118px;color:var(--green);font-weight:600}
body.clean #menu,body.clean #tools,body.clean #panel,body.clean #nav,body.clean #helpBtn,body.clean #help{display:none}
body.clean #callout{left:32px;bottom:32px}
</style>
</head>
<body>
<svg id="stage" xmlns="http://www.w3.org/2000/svg">
  <g id="world"></g>
  <g id="ink" fill="none" stroke-linecap="round" stroke-linejoin="round"></g>
</svg>

<button id="menu" title="Mostrar/ocultar a lista de passos">☰ AmazonVision 4.0</button>
<div id="tools">
  <button id="tMove" class="on" title="Mover e dar zoom (V)">✥</button>
  <button id="tPen" title="Caneta para riscar ao vivo (P)">✎</button>
  <button id="tClear" title="Apagar os riscos (C)">⌫</button>
  <hr>
  <div id="swatches"></div>
  <hr>
  <button id="tFull" title="Tela cheia (F)">⛶</button>
  <button id="tClean" title="Esconder a interface (H)">◐</button>
</div>
<aside id="panel">
  <div class="ph"><button id="collapse">▾ passos</button><button id="dimBtn" class="on" title="Esmaecer as outras seções (D)">destaque</button></div>
  <ol id="list"></ol>
</aside>
<nav id="nav">
  <button id="prev" title="Voltar (←)">←</button>
  <div id="dots"></div>
  <button id="next" title="Avançar (→ ou espaço)">→</button>
  <button id="ov" title="Ver o quadro inteiro (O)">quadro inteiro</button>
</nav>
<div id="callout"><div class="lab"></div><div class="tit"></div><div class="sub"></div></div>
<button id="helpBtn" title="Atalhos">?</button>
<div id="help">
  <b>→ / espaço</b> avançar<br>
  <b>←</b> voltar<br>
  <b>Home / End</b> primeiro / último<br>
  <b>O</b> quadro inteiro<br>
  <b>D</b> destaque (esmaecer o resto)<br>
  <b>P / V</b> caneta / mover<br>
  <b>1 a 5</b> cor da caneta<br>
  <b>C</b> apagar os riscos<br>
  <b>roda do mouse</b> zoom<br>
  <b>F</b> tela cheia · <b style="min-width:0">H</b> esconder interface
</div>

