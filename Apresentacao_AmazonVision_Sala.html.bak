trokeLineDash.join(" ").trim()),s.strokeLineDashOffset&&e.setAttribute("stroke-dashoffset",`${s.strokeLineDashOffset}`);break;case"fillPath":e=n.createElementNS(nt,"path"),e.setAttribute("d",this.opsToPath(h,a)),e.setAttribute("stroke","none"),e.setAttribute("stroke-width","0"),e.setAttribute("fill",s.fill||""),"curve"!==t.shape&&"polygon"!==t.shape||e.setAttribute("fill-rule","evenodd");break;case"fillSketch":e=this.fillSketch(n,h,s)}e&&o.appendChild(e)}return o}fillSketch(t,e,s){let n=s.fillWeight;n<0&&(n=s.strokeWidth/2);const o=t.createElementNS(nt,"path");return o.setAttribute("d",this.opsToPath(e,s.fixedDecimalPlaceDigits)),o.setAttribute("stroke",s.fill||""),o.setAttribute("stroke-width",n+""),o.setAttribute("fill","none"),s.fillLineDash&&o.setAttribute("stroke-dasharray",s.fillLineDash.join(" ").trim()),s.fillLineDashOffset&&o.setAttribute("stroke-dashoffset",`${s.fillLineDashOffset}`),o}get generator(){return this.gen}getDefaultOptions(){return this.gen.defaultOptions}opsToPath(t,e){return this.gen.opsToPath(t,e)}line(t,e,s,n,o){const a=this.gen.line(t,e,s,n,o);return this.draw(a)}rectangle(t,e,s,n,o){const a=this.gen.rectangle(t,e,s,n,o);return this.draw(a)}ellipse(t,e,s,n,o){const a=this.gen.ellipse(t,e,s,n,o);return this.draw(a)}circle(t,e,s,n){const o=this.gen.circle(t,e,s,n);return this.draw(o)}linearPath(t,e){const s=this.gen.linearPath(t,e);return this.draw(s)}polygon(t,e){const s=this.gen.polygon(t,e);return this.draw(s)}arc(t,e,s,n,o,a,h=!1,r){const i=this.gen.arc(t,e,s,n,o,a,h,r);return this.draw(i)}curve(t,e){const s=this.gen.curve(t,e);return this.draw(s)}path(t,e){const s=this.gen.path(t,e);return this.draw(s)}}return{canvas:(t,e)=>new st(t,e),svg:(t,e)=>new ot(t,e),generator:t=>new et(t),newSeed:()=>et.newSeed()}}();
</script>
<script>
'use strict';
const C={ink:'#e7ece5',dim:'#8a958c',green:'#4ade80',blue:'#60a5fa',amber:'#f5a524',red:'#f87171',purple:'#c084fc',brown:'#d39a6a'};
const NS='http://www.w3.org/2000/svg';
const svg=document.getElementById('stage'), world=document.getElementById('world'), inkLayer=document.getElementById('ink');
const rc=rough.svg(svg);

/* ---------- roteiro ---------- */
const STEPS=[
  {t:'AmazonVision 4.0',r:0},
  {t:'O problema',r:1},
  {t:'A proposta',r:2},
  {t:'Os produtos',r:3},
  {t:'Classes A, B e C',r:4},
  {t:'O protótipo',r:5,note:['Bancada','ESP32 + 2 sensores + servo','a luz de LED deixa todas as fotos iguais']},
  {t:'O ciclo (parte 1)',r:6,note:['Exemplo de análise','Castanha · Classe B · 94%','decisão: rejeitar']},
  {t:'O ciclo (parte 2)',r:6,note:['Separação','Servo + pá desviadora','aprovada: o servo fica parado e a peça segue']},
  {t:'Quem faz o quê',r:7,note:['Comunicação','USB / Serial','protocolo próprio, com reconexão automática']},
  {t:'Por dentro do software',r:8},
  {t:'Máquina de estados',r:9,note:['Segurança','Nunca se move sozinha','botão de emergência físico e rearme explícito']},
  {t:'Vários produtos',r:10},
  {t:'Como a IA aprende',r:11,note:['Roda no notebook','IA 100% local','funciona sem internet na feira']},
  {t:'Dados próprios',r:12},
  {t:'O desafio dos dados',r:13,note:['Técnica','Detecção de anomalia','aprende o normal e marca o diferente']},
  {t:'O painel',r:14},
  {t:'Rastreabilidade',r:15},
  {t:'Testes',r:16},
  {t:'Onde estamos',r:17,note:['Próximo passo','Montar e calibrar a bancada','e fotografar as peças reais']},
  {t:'Obrigado!',r:18},
];

/* ---------- motor de desenho ---------- */
const RW=1600,RH=900,COLS=5,CW=2000,CH=1250;
const NREG=19;
const RX=i=>{const row=Math.floor(i/COLS),c=i%COLS;return (row%2?COLS-1-c:c)*CW};
const RY=i=>Math.floor(i/COLS)*CH;
let OX=0,OY=0,REG=0,STEP=1,BEAT=0,lock=0,seed=7;
const ELS=[];
const X=v=>OX+v, Y=v=>OY+v;
const rgba=(hex,a)=>{const n=parseInt(hex.slice(1),16);return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`};
const SO=o=>Object.assign({roughness:1.1,bowing:.9,strokeWidth:2.2,stroke:C.ink,seed:seed++,hachureGap:9,fillWeight:1.4,hachureAngle:-41},o);
function mk(tag,attrs,parent){const e=document.createElementNS(NS,tag);for(const k in attrs)if(attrs[k]!=null)e.setAttribute(k,attrs[k]);if(parent)parent.appendChild(e);return e}
function auto(){if(!lock)BEAT++}
const RG={};
function put(node,kind){
  if(!RG[REG])RG[REG]=mk('g',{class:'rg'},world);
  const g=mk('g',{class:'el'},RG[REG]);g.appendChild(node);
  const rec={g,kind,step:STEP,region:REG,beat:BEAT,shown:false};
  // comprimentos medidos uma vez, na montagem (contorno antes da hachura)
  if(kind==='draw')rec.paths=[...g.querySelectorAll('path')].map(p=>[p,p.getTotalLength()]).filter(x=>x[1]>0).reverse();
  ELS.push(rec);return rec;
}
function at(n){STEP=n;BEAT=0}
const rr=(x,y,w,h,r)=>{r=Math.min(r,w/2,h/2);return `M${x+r} ${y} L${x+w-r} ${y} Q${x+w} ${y} ${x+w} ${y+r} L${x+w} ${y+h-r} Q${x+w} ${y+h} ${x+w-r} ${y+h} L${x+r} ${y+h} Q${x} ${y+h} ${x} ${y+h-r} L${x} ${y+r} Q${x} ${y} ${x+r} ${y} Z`};
const lbox=rec=>{const b=rec.g.getBBox();return {x:b.x-OX,y:b.y-OY,w:b.width,h:b.height}};

function T(x,y,str,o={}){
  // a Roboto é mais miúda que a fonte manuscrita: legendas ganham 10%
  auto();let size=o.size||34;if(size<30)size=Math.round(size*1.1);
  const t=mk('text',{x:X(x),y:Y(y),'font-size':size,'font-weight':o.weight||(size>=40?700:size>=30&&(o.color||C.ink)!==C.dim?500:400),fill:o.color||C.ink,'text-anchor':o.anchor||'start','dominant-baseline':o.base});
  if(Array.isArray(str)){for(const [s,c] of str){const ts=mk('tspan',{fill:c},t);ts.textContent=s}}
  else String(str).split('\n').forEach((ln,i)=>{const ts=mk('tspan',{x:X(x),dy:i?(o.lh||1.3)*size:0},t);ts.textContent=ln});
  return put(t,'text');
}
function box(x,y,w,h,o={}){
  auto();lock++;const col=o.color||C.ink,r=o.r??18;
  if(o.tint!==false&&o.color)put(mk('path',{d:rr(X(x),Y(y),w,h,r),fill:col,'fill-opacity':o.tintA??.07}),'fade');
  const n=rc.path(rr(X(x),Y(y),w,h,r),SO({stroke:o.stroke||col,strokeWidth:o.sw||2.2,fill:o.hatch?rgba(col,o.hatchA??.3):undefined,strokeLineDash:o.dash?[12,10]:undefined,fillStyle:o.fillStyle||'hachure'}));
  put(n,o.dash?'fade':'draw');lock--;return {x,y,w,h};
}
function circ(cx,cy,d,o={}){
  auto();const col=o.color||C.ink;
  return put(rc.circle(X(cx),Y(cy),d,SO({stroke:col,strokeWidth:o.sw||2.2,fill:o.hatch?rgba(col,o.hatchA??.45):undefined,strokeLineDash:o.dash?[12,10]:undefined,fillStyle:o.fillStyle||'hachure',hachureGap:o.gap||7})),o.dash?'fade':'draw');
}
function ell(cx,cy,w,h,o={}){
  auto();const col=o.color||C.ink;
  return put(rc.ellipse(X(cx),Y(cy),w,h,SO({stroke:col,fill:o.hatch===false?undefined:rgba(col,o.hatchA??.5),hachureGap:o.gap||6})),'draw');
}
function line(pts,o={}){
  auto();const P=pts.map(([a,b])=>[X(a),Y(b)]);
  return put(rc[o.curve?'curve':'linearPath'](P,SO({stroke:o.color||C.ink,strokeWidth:o.sw||2.2,roughness:o.rough??1.1,strokeLineDash:o.dash?[10,9]:undefined})),o.dash?'fade':'draw');
}
function head2(P,col,sw,i1,i2){
  const [x2,y2]=P[i2],[x1,y1]=P[i1];const a=Math.atan2(y2-y1,x2-x1),L=20,sp=.5;
  put(rc.linearPath([[x2-L*Math.cos(a-sp),y2-L*Math.sin(a-sp)],[x2,y2],[x2-L*Math.cos(a+sp),y2-L*Math.sin(a+sp)]],SO({stroke:col,strokeWidth:sw,roughness:.6})),'draw');
}
let fid=0;
function flow(P,col,dur,n,curve){
  const id='fp'+(fid++);
  let d=`M${P[0][0]} ${P[0][1]}`;
  if(curve&&P.length===3){const [a,b,c]=P;d+=` Q${2*b[0]-(a[0]+c[0])/2} ${2*b[1]-(a[1]+c[1])/2} ${c[0]} ${c[1]}`}
  else for(let i=1;i<P.length;i++)d+=` L${P[i][0]} ${P[i][1]}`;
  const g=mk('g',{});mk('path',{id,d,fill:'none',stroke:'none'},g);
  for(let i=0;i<n;i++){
    const c=mk('g',{},g);mk('circle',{r:11,fill:col,'fill-opacity':.18},c);mk('circle',{r:5.5,fill:col},c);
    const am=mk('animateMotion',{dur:dur+'s',repeatCount:'indefinite',begin:(-i*dur/n).toFixed(2)+'s'},c);
    const mp=mk('mpath',{},am);mp.setAttribute('href','#'+id);mp.setAttributeNS('http://www.w3.org/1999/xlink','xlink:href','#'+id);
  }
  const rec=put(g,'fade');rec.flow=true;rec.g.classList.add('flow');
}
function arrow(pts,o={}){
  auto();lock++;const col=o.color||C.ink,sw=o.sw||2.2;
  const P=pts.map(([a,b])=>[X(a),Y(b)]);
  let D=P;
  if(o.curve&&P.length===3){const [a,b,c]=P;D=[a,[(a[0]+b[0])/2+(b[0]-(a[0]+c[0])/2)*.5,(a[1]+b[1])/2+(b[1]-(a[1]+c[1])/2)*.5],b,[(b[0]+c[0])/2+(b[0]-(a[0]+c[0])/2)*.5,(b[1]+c[1])/2+(b[1]-(a[1]+c[1])/2)*.5],c]}
  put(rc[o.curve?'curve':'linearPath'](D,SO({stroke:col,strokeWidth:sw,strokeLineDash:o.dash?[10,9]:undefined})),o.dash?'fade':'draw');
  if(o.head!==false)head2(D,col,sw,D.length-2,D.length-1);
  if(o.both)head2(D,col,sw,1,0);
  if(o.label){const m=pts[Math.floor((pts.length-1)/2)],n=pts[Math.ceil((pts.length-1)/2)];T((m[0]+n[0])/2+(o.lx||0),(m[1]+n[1])/2+(o.ly??-14),o.label,{size:o.ls||25,color:o.lc||C.dim,anchor:'middle'})}
  if(o.flow)flow(P,o.fc||col,o.fd||2.2,o.fn||2,o.curve);
  lock--;
}
function pill(x,y,str,o={}){
  auto();lock++;const size=o.size||30,col=o.color||C.ink;
  const t=mk('text',{'font-size':size,'font-weight':500,fill:o.tc||(o.color?col:C.ink),'text-anchor':'middle','dominant-baseline':'central'},world);t.textContent=str;
  const w=t.getBBox().width+size*1.15,h=size*1.75;
  const px=o.anchor==='middle'?x-w/2:o.anchor==='end'?x-w:x;
  box(px,y-h/2,w,h,{color:col,r:h/2,hatch:o.hatch,hatchA:o.hatchA??.22,dash:o.dash,sw:o.sw||2});
  t.setAttribute('x',X(px+w/2));t.setAttribute('y',Y(y)+size*.04);
  put(t,'text');lock--;
  return {x:px,y:y-h/2,w,h,cx:px+w/2,cy:y};
}
function card(x,y,w,h,o={}){
  auto();lock++;const col=o.color||C.ink;
  box(x,y,w,h,{color:col,hatch:o.hatch,hatchA:o.hatchA??.14,dash:o.dash,tintA:o.tintA,r:o.r});
  const sz=o.size||36;
  if(o.center){
    const cx=x+w/2;let ty=y+(o.titleY||(o.icon?150:62));
    if(o.icon)T(cx,y+(o.iconY||86),o.icon,{size:o.iconSize||54,anchor:'middle'});
    if(o.title)T(cx,ty,o.title,{size:sz,color:o.tcol||C.ink,anchor:'middle'});
    if(o.sub)T(cx,ty+(o.subGap||46),o.sub,{size:o.subSize||26,color:C.dim,anchor:'middle'});
  }else{
    let tx=x+28;
    if(o.icon){T(x+26,y+(o.titleY||60),o.icon,{size:sz});tx+=sz*1.35}
    if(o.title)T(tx,y+(o.titleY||60),o.title,{size:sz,color:o.tcol||C.ink});
    if(o.sub)T(x+28,y+(o.subY||(o.titleY||60)+48),o.sub,{size:o.subSize||26,color:C.dim});
  }
  if(o.tag)pill(x+w-18,y,o.tag,{anchor:'end',size:20,color:o.tagColor||col,hatch:true});
  lock--;return {x,y,w,h};
}
function quote(x,y,w,h,a,b){auto();lock++;box(x,y,w,h,{});T(x+w/2,y+h/2-6,a,{size:36,anchor:'middle'});if(b)T(x+w/2,y+h/2+34,b,{size:26,anchor:'middle',color:C.dim});lock--}
function head(n,title){
  auto();lock++;
  put(mk('rect',{x:X(40),y:Y(44),width:64,height:64,rx:13,fill:C.green}),'text');
  T(72,77,String(n),{size:34,color:'#05230f',anchor:'middle',base:'central'});
  const r=T(132,98,title,{size:58});const w=lbox(r).w;
  line([[132,124],[132+w*.55,127],[132+w,122]],{color:C.green,sw:2.6,rough:.8});
  lock--;
}
function stick(x,y,o={}){
  auto();lock++;const col=o.color||C.ink;
  circ(x,y-130,58,{color:col});
  line([[x,y-101],[x,y-10]],{color:col});
  line(o.wave?[[x-50,y-40],[x,y-75],[x+46,y-130]]:[[x-50,y-40],[x,y-75],[x+50,y-40]],{color:col});
  line([[x-38,y+62],[x,y-10],[x+38,y+62]],{color:col});
  line([[x-12,y-125],[x,y-117],[x+12,y-125]],{color:col,sw:1.8,rough:.4});
  if(o.label)T(x,y+108,o.label,{size:o.ls||27,anchor:'middle',color:C.dim});
  lock--;
}
function nut(cx,cy,w,h,col){auto();lock++;ell(cx,cy,w,h,{color:col});line([[cx-w*.28,cy-h*.05],[cx,cy-h*.2],[cx+w*.28,cy-h*.02]],{color:col,sw:1.6,rough:.6});lock--}
function node(x,y,n,label,col){auto();lock++;circ(x,y,92,{color:col,hatch:true,hatchA:.3});T(x,y+2,String(n),{size:40,anchor:'middle',base:'central'});T(x,y+84,label,{size:26,anchor:'middle',color:C.dim});lock--}
function row(x,y,labels,o={}){const out=[];let cx=x;labels.forEach((s,i)=>{const p=pill(cx,y,s,o);out.push(p);cx=p.x+p.w+(o.gap||22);if(o.arrows&&i<labels.length-1){}});return out}
function seq(x,y,labels,o={}){let cx=x;const ps=[];labels.forEach((s,i)=>{const p=pill(cx,y,s,{...o,color:(o.colors||[])[i]||o.color});ps.push(p);cx=p.x+p.w+70;if(i<labels.length-1)arrow([[p.x+p.w+10,y],[cx-10,y]],{color:C.dim})});return ps}
function rnd(s){return()=>{s|=0;s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}

/* ---------- conteúdo ---------- */
const REGIONS=[
// 0 · capa
()=>{
  T(800,330,[['AmazonVision ',C.ink],['4.0',C.green]],{size:128,anchor:'middle'});
  line([[330,375],[800,390],[1270,372]],{color:C.green,sw:3,rough:.7});
  T(800,470,'Esteira seletora inteligente multiproduto',{size:50,anchor:'middle'});
  T(800,528,'IA aplicada à automação e à bioeconomia amazônica',{size:32,anchor:'middle',color:C.dim});
  box(500,700,600,54,{color:C.dim,r:27,hatch:true,hatchA:.22});
  circ(527,727,40,{color:C.dim});circ(1073,727,40,{color:C.dim});
  circ(640,676,46,{color:C.amber,hatch:true});nut(800,678,66,40,C.brown);circ(960,676,44,{color:C.amber,hatch:true});
  box(760,580,80,48,{color:C.blue,r:10});
  line([[775,632],[766,662]],{color:C.blue,dash:true});line([[825,632],[834,662]],{color:C.blue,dash:true});
