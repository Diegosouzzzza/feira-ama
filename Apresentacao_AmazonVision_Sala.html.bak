// 9 · máquina de estados
()=>{
  head(9,'A máquina de estados');
  const g=90;
  const p1=pill(90,290,'Pronta',{color:C.green,hatch:true});
  const p2=pill(p1.x+p1.w+g,290,'Levando à inspeção');
  const p3=pill(p2.x+p2.w+g,290,'Estabilizando');
  const p4=pill(p3.x+p3.w+g,290,'Analisando',{color:C.purple,hatch:true});
  [[p1,p2],[p2,p3],[p3,p4]].forEach(([a,b])=>arrow([[a.x+a.w+8,290],[b.x-8,290]],{color:C.dim}));
  const p5=pill(p4.x+p4.w,580,'Levando à separação',{anchor:'end'});
  arrow([[p4.cx-40,290+p4.h/2+6],[p4.cx-40,580-p5.h/2-6]],{color:C.dim,flow:true,fn:1,fc:C.purple});
  const p6=pill(p5.x-g,580,'Separando',{anchor:'end',color:C.amber,hatch:true});
  const p7=pill(p6.x-g,580,'Liberando',{anchor:'end'});
  [[p5,p6],[p6,p7]].forEach(([a,b])=>arrow([[a.x-8,580],[b.x+b.w+8,580]],{color:C.dim}));
  arrow([[p7.x-8,580],[p1.cx-30,540],[p1.cx,290+p1.h/2+8]],{curve:true,color:C.green});
  const rv=pill(1560,435,'Aguardando revisão',{anchor:'end',color:C.amber,dash:true,size:26});
  arrow([[p4.x+p4.w-30,290+p4.h/2+4],[rv.cx+40,435-rv.h/2-4]],{color:C.amber,dash:true});
  T(rv.cx+60,345,'inconclusivo',{size:22,color:C.amber});
  arrow([[rv.cx-20,435+rv.h/2+4],[p5.x+p5.w-60,580-p5.h/2-4]],{color:C.amber,dash:true});
  T(rv.cx+30,505,'operador decide',{size:22,color:C.amber});
  const f=pill(90,770,'Falha',{color:C.red,hatch:true});
  const e=pill(f.x+f.w+30,770,'Emergência',{color:C.red,hatch:true});
  T(e.x+e.w+36,780,'qualquer problema para tudo; para voltar, só com rearme',{size:26,color:C.dim});
},
