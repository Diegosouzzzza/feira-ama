# Copie para .env (nesta mesma pasta api\) e ajuste:   Copy-Item .env.example .env
# Todas as variáveis são opcionais; sem .env o sistema sobe em modo simulado.
# Uma variável por linha, sem aspas. O passo a passo da bancada real está em docs\bancada-real.md.

# ---------------------------------------------------------------- geral
# AV_MODE=simulado            # simulado | real
# AV_HOST=127.0.0.1
# AV_PORT=8000
# AV_DATA_DIR=...             # padrão: %LOCALAPPDATA%\AmazonVision\<modo>
# AV_CONTROL_TTL_MINUTES=30   # inatividade até liberar o controle do operador
# AV_LOG_TO_FILE=true         # logs JSON Lines em <dados>\logs
# AV_IMAGE_RETENTION_DAYS=30  # fotos de inspeção de lotes encerrados mais antigas são apagadas

# ---------------------------------------------------------------- bancada real
# Descomente este bloco para operar com o ESP32 e a câmera de verdade.
#
# AV_MODE=real
#
# Porta USB Serial do ESP32 DevKit V1 (115200 baud). Para descobrir: Gerenciador de
# Dispositivos > Portas (COM e LPT), ou http://127.0.0.1:8000/api/diagnostics/serial-ports
# AV_SERIAL_PORT=COM5
# AV_SERIAL_BAUD_RATE=115200
# AV_DEVICE_SILENCE_MS=3000   # sem mensagens da placa por este tempo = desconectada
#
# Câmera. Para descobrir qual índice é qual: .\scripts\listar-cameras.ps1
#
#   a) Celular como webcam virtual (DroidCam ou Iriun, por USB ou Wi-Fi): um índice.
#      Em geral 0 é a webcam do notebook e o celular é 1 ou 2.
# AV_CAMERA_SOURCE=1
#
#   b) Celular como stream pelo cabo USB (app IP Webcam + "adb forward tcp:8080 tcp:8080"):
# AV_CAMERA_SOURCE=http://127.0.0.1:8080/video
#
#   c) Celular como stream por Wi-Fi (IP Webcam: porta 8080; DroidCam: porta 4747):
# AV_CAMERA_SOURCE=http://192.168.0.50:8080/video
# AV_CAMERA_SOURCE=rtsp://192.168.0.50:8080/h264_ulaw.sdp
#
# Gira a imagem no sentido horário, para o celular montado de lado: 0, 90, 180 ou 270.
# AV_CAMERA_ROTATE=0
#
# Tempo que a inspeção espera por uma imagem nova da peça. Stream de celular entrega quadros
# em rajadas: se aparecer "A câmera não entregou uma imagem nova" (STALE_FRAME), aumente.
# Mantenha bem abaixo do "Prazo da decisão" do produto (tela Configuração).
# AV_CAMERA_CAPTURE_TIMEOUT_S=2.0
#
# Só para câmera por índice (no stream, resolução/foco/exposição são ajustados no app do celular):
# AV_CAMERA_WIDTH=1280
# AV_CAMERA_HEIGHT=720
# AV_CAMERA_EXPOSURE=-6       # unidades do driver; deixe comentado para o automático da câmera

# ---------------------------------------------------------------- modo simulado
# AV_SIM_SPEED=1              # acelera a física da esteira (1 = tempo real)
# AV_SIM_SEED=                # semente do sorteio de itens (vazio = aleatório)
# AV_SIM_PHOTOS=              # pasta de fotos reais mostradas pela câmera simulada
