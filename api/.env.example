# Copie para .env e ajuste. Todas as variáveis são opcionais.
# AV_MODE=simulado            # simulado | real
# AV_HOST=127.0.0.1
# AV_PORT=8000
# AV_DATA_DIR=...             # padrão: %LOCALAPPDATA%\AmazonVision\<modo>
# AV_CONTROL_TTL_MINUTES=30   # inatividade até liberar o controle do operador
# AV_LOG_TO_FILE=true         # logs JSON Lines em <dados>\logs
